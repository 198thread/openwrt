#!/bin/sh /etc/rc.common
START=50
USE_PROCD=1

# zzz-diag v110 — GIC_SH_PEND + INTC probe + ftrace setup.
#
# v109 root cause under investigation:
#   IRQ 22 (GIC_SHARED 20, QDMA LAN0) fires 0 times after all int_enable fixes.
#   Unknown: does the QDMA output signal actually reach GIC input 20?
#
# v110 new diagnostics:
#   Section 7: GIC_SH_PEND (0x1f8c0480) — bit 20 tells us if QDMA reaches GIC at all.
#   Section 8: INTC probe (0x1fb40000-10) — checks intermediate interrupt controller.
#   Section 9: ftrace — traces en75_irq_handler call path if CONFIG_FUNCTION_TRACER=y.
#
# Respawn fix: USE_PROCD=1 + respawn 0 0 1 — prevents procd from restarting this script.
# (v109 bug: without USE_PROCD the script was restarted 4+ times causing nested log output)

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /etc/zzz-diag-run.sh
	procd_set_param respawn 0 0 1
	procd_close_instance
}
