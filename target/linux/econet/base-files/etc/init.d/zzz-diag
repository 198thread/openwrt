#!/bin/sh /etc/rc.common
START=99
ENABLED=1
start() {
	exec > /dev/console 2>&1
	echo "=== DIAG START ==="
	echo "--- /dev entries ---"
	ls -la /dev/ttyS* /dev/console /dev/watchdog* 2>&1
	echo "--- /proc/interrupts ---"
	cat /proc/interrupts
	echo "--- processes ---"
	ps w
	echo "--- dmesg tail ---"
	dmesg | tail -50
	echo "--- ip link ---"
	ip link
	echo "--- mdio_bus ---"
	ls /sys/class/mdio_bus/ 2>&1
	echo "--- /sys/class/net ---"
	ls /sys/class/net/ 2>&1
	echo "--- mtd ---"
	cat /proc/mtd
	echo "=== DIAG END ==="
}
