#!/bin/sh /etc/rc.common
START=99
ENABLED=1

# Focused diagnostic: econet_eth probe -EINVAL + IRQ/reset state
# v55: stripped to essentials — probe failure, regs, IRQs, eth0 state
log() { echo "$*"; }
sec() { echo; echo "=== $* ==="; }

start() {
	exec > /dev/kmsg 2>&1
	echo "=== DIAG START v55 ==="

	# ----------------------------------------------------------------
	# 1. ECONET ETH PROBE FAILURE
	# ----------------------------------------------------------------
	sec "ECONET PROBE"

	log "probe result (dmesg):"
	dmesg | grep -F "econet_eth" -e "1fb50000" | while IFS= read -r line; do log "  $line"; done

	log "driver sysfs:"
	drv=/sys/bus/platform/drivers/econet_eth
	if [ -d "$drv" ]; then
		log "  exists; bound devices:"
		for f in "$drv"/*/; do [ -L "$f" ] && log "    $(basename $f)"; done
	else
		log "  ABSENT"
	fi

	log "platform device 1fb50000.ethernet:"
	pdev=/sys/bus/platform/devices/1fb50000.ethernet
	if [ -d "$pdev" ]; then
		[ -L "$pdev/driver" ] && log "  BOUND: $(readlink $pdev/driver 2>/dev/null | sed 's|.*/||')" || log "  UNBOUND"
		log "  power/runtime_status: $(cat $pdev/power/runtime_status 2>/dev/null)"
	else
		log "  NOT in sysfs"
	fi

	# ----------------------------------------------------------------
	# 2. RESET / CLK STATE
	# ----------------------------------------------------------------
	sec "RESET REGS (SCU)"

	# EN751221 SCU: RST_CTRL1=0x1fb00834 (FE_RST=bit21, QDMA1=bit1, QDMA2=bit2)
	#               RST_CTRL2=0x1fb00830
	log "RST_CTRL1 (0x1fb00834): bit21=FE_RST bit1=QDMA1 bit2=QDMA2"
	val=$(dd if=/dev/mem bs=4 count=1 skip=$(( 0x1fb00834 / 4 )) 2>/dev/null | hexdump -e '1/4 "%08x\n"')
	log "  = $val"
	log "RST_CTRL2 (0x1fb00830):"
	val=$(dd if=/dev/mem bs=4 count=1 skip=$(( 0x1fb00830 / 4 )) 2>/dev/null | hexdump -e '1/4 "%08x\n"')
	log "  = $val"

	log "reset/clk early dmesg:"
	dmesg | grep -F "reset" -e "clk" -e "clock" | grep -F "[    0." -e "[    1." -e "[    2." -e "[    3." -e "[    4." -e "[    5." | \
		while IFS= read -r line; do log "  $line"; done

	# ----------------------------------------------------------------
	# 3. IRQ TABLE
	# ----------------------------------------------------------------
	sec "INTERRUPTS"

	log "DT interrupts for ethernet@1fb50000:"
	intnode=/proc/device-tree/ethernet@1fb50000
	[ -f "$intnode/interrupts" ] && hexdump -C "$intnode/interrupts" 2>/dev/null | while IFS= read -r line; do log "  $line"; done \
		|| log "  NOT FOUND"

	log "/proc/interrupts (full):"
	while IFS= read -r line; do log "  $line"; done < /proc/interrupts 2>/dev/null

	# ----------------------------------------------------------------
	# 4. MANUAL RE-BIND ATTEMPT
	# ----------------------------------------------------------------
	sec "RE-BIND"
	log "echo 1fb50000.ethernet > bind:"
	echo "1fb50000.ethernet" > /sys/bus/platform/drivers/econet_eth/bind 2>&1
	sleep 1
	[ -L "/sys/bus/platform/devices/1fb50000.ethernet/driver" ] && log "  SUCCESS" || log "  FAILED"
	log "dmesg tail after rebind:"
	dmesg | tail -15 | while IFS= read -r line; do log "  $line"; done

	# ----------------------------------------------------------------
	# 5. ETH0 STATE
	# ----------------------------------------------------------------
	sec "ETH0"
	for f in /sys/class/net/*; do
		ifname="${f##*/}"
		[ "$ifname" = "lo" ] && continue
		operstate=$(cat "$f/operstate" 2>/dev/null)
		carrier=$(cat "$f/carrier" 2>/dev/null)
		log "  $ifname: operstate=$operstate carrier=$carrier"
	done
	log "ip addr:"
	ip addr 2>/dev/null | while IFS= read -r line; do log "  $line"; done

	# ----------------------------------------------------------------
	# 6. KERNEL ERRORS SUMMARY
	# ----------------------------------------------------------------
	sec "KERNEL ERRORS"
	dmesg | grep -F "error -" | while IFS= read -r line; do log "  $line"; done
	dmesg | grep -F "failed with error" | while IFS= read -r line; do log "  $line"; done

	echo "=== DIAG END v55 ==="
}
