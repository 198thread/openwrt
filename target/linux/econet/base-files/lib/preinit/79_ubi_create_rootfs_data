#!/bin/sh
# Create the rootfs_data UBI volume on first boot.
# The kernel auto-attaches the MTD partition named "ubi" as ubi0 via
# ubi_auto_attach(), so /dev/ubi0 is available before this hook runs.
# fstools/mount_root locates the volume by name "rootfs_data" via sysfs.

ubi_create_rootfs_data() {
	# Create the volume if none exist (first boot on blank flash)
	if [ "$(cat /sys/class/ubi/ubi0/volumes_count 2>/dev/null)" = "0" ]; then
		ubimkvol /dev/ubi0 -N rootfs_data -m
	fi
}

boot_hook_add preinit_main ubi_create_rootfs_data
