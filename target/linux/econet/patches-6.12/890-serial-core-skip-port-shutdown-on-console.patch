--- a/drivers/tty/serial/serial_core.c
+++ b/drivers/tty/serial/serial_core.c
@@ -1929,8 +1929,16 @@
 	wake_up_interruptible(&port->delta_msr_wait);
 
 	if (uport) {
-		/* Free the IRQ and disable the port. */
-		uport->ops->shutdown(uport);
+		/*
+		 * Do not shut down a console port. serial8250_do_shutdown()
+		 * writes UART_IER=0 (killing all interrupts) and calls
+		 * release_irq(), disabling the IRQ line entirely.
+		 * This path is reached when procd askconsole opens ttyS0
+		 * via TIOCSCTTY(force=1) -> __tty_hangup() close path
+		 * -> uart_close() -> uart_tty_port_shutdown() -> here.
+		 */
+		if (!uart_console(uport))
+			uport->ops->shutdown(uport);
 
 		/* Ensure that the IRQ handler isn't running on another CPU. */
 		synchronize_irq(uport->irq);
