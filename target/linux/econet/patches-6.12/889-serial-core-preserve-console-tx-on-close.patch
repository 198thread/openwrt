--- a/drivers/tty/serial/serial_core.c
+++ b/drivers/tty/serial/serial_core.c
@@ -1789,7 +1789,18 @@ static void uart_tty_port_shutdown(struct tty_port *port)
 	uart_port_lock_irq(uport);
 	uport->ops->stop_rx(uport);
 	uart_port_unlock_irq(uport);
-
-	serial_base_port_shutdown(uport);
+
+	/*
+	 * Do not disable TX on a console port. When __tty_hangup() detects
+	 * that the tty being hung up is also a console file (cons_filp != NULL),
+	 * it takes the close path (tty->ops->close) instead of the hangup path
+	 * (tty->ops->hangup). This leads here via tty_port_close() rather than
+	 * uart_hangup() -> uart_shutdown(). The guard in serial_port.c
+	 * (patch 888) only covers the hangup path; this covers the close path.
+	 * Both are needed to prevent TX being silenced on console ports.
+	 */
+	if (!uart_console(uport))
+		serial_base_port_shutdown(uport);
+
 	uart_port_shutdown(port);
