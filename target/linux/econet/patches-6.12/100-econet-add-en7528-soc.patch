From: Ahmed Naseef <naseefkm@gmail.com>
Subject: mips: econet: add EN7528 SoC support and GIC-based SMP plumbing

The EN7528 is a little-endian dual-core MIPS 1004Kc SoC used in xPON
devices. Unlike the big-endian EN751221, EN7528 uses the MIPS GIC
interrupt controller for SMP.

This patch makes three changes that are prerequisites for all GIC-based
SoCs in the EcoNet family:

1. Kconfig: add SOC_ECONET_EN7528; move CPU_BIG_ENDIAN into
   SOC_ECONET_EN751221 (EN7528 is little-endian).

2. init.c: make UART_BASE endian-aware (LE: byte at offset 0,
   BE: byte at offset 3). Add the same fix to uart-16550.c.

3. init.c: add CM/CPC/CPS SMP plumbing for GIC-based SoCs.
   EN7528 and EN751627 both require the same three-call sequence.
   A single #if guard covers both; add future GIC SoCs to this #if.

Signed-off-by: Ahmed Naseef <naseefkm@gmail.com>
---
--- a/arch/mips/econet/Kconfig
+++ b/arch/mips/econet/Kconfig
@@ -12,6 +12,7 @@
 	config SOC_ECONET_EN751221
 		bool "EN751221 family"
 		select COMMON_CLK
+		select CPU_BIG_ENDIAN
 		select ECONET_EN751221_INTC
 		select IRQ_MIPS_CPU
 		select SMP
@@ -22,6 +23,24 @@
 		  They are based on single core MIPS 34Kc processors. To boot
 		  this kernel, you will need a device tree such as
 		  MIPS_RAW_APPENDED_DTB=y, and a root filesystem.
+	config SOC_ECONET_EN7528
+		bool "EN7528 family"
+		select COMMON_CLK
+		select CPU_LITTLE_ENDIAN
+		select HAVE_PCI
+		select IRQ_MIPS_CPU
+		select MIPS_CPU_SCACHE
+		select MIPS_GIC
+		select PCI_DRIVERS_GENERIC
+		select SMP
+		select SMP_UP
+		select SYS_SUPPORTS_HIGHMEM
+		select SYS_SUPPORTS_MIPS_CPS
+		select SYS_SUPPORTS_MULTITHREADING
+		select SYS_SUPPORTS_SMP
+		help
+		  The EN7528 family with dual-core MIPS 1004Kc.
+		  Requires MIPS_RAW_APPENDED_DTB=y for boot.
 endchoice
 
 choice
--- a/arch/mips/econet/init.c
+++ b/arch/mips/econet/init.c
@@ -16,11 +16,16 @@
 #include <asm/prom.h>
 #include <asm/smp-ops.h>
 #include <asm/reboot.h>
+#include <asm/mips-cps.h>
 
 #define CR_AHB_RSTCR		((void __iomem *)CKSEG1ADDR(0x1fb00040))
 #define RESET			BIT(31)
 
-#define UART_BASE		CKSEG1ADDR(0x1fbf0003)
+#ifdef CONFIG_CPU_LITTLE_ENDIAN
+#define UART_BASE		CKSEG1ADDR(0x1fbf0000)	/* LE: byte at offset 0 */
+#else
+#define UART_BASE		CKSEG1ADDR(0x1fbf0003)	/* BE: byte at offset 3 */
+#endif
 #define UART_REG_SHIFT		2
 
 static void hw_reset(char *command)
@@ -56,6 +61,18 @@
 {
 	unflatten_and_copy_device_tree();
 
+	/*
+	 * GIC-based SoCs (EN7528, EN751627, any future GIC variant):
+	 * probe CM and CPC, register CPS SMP ops.
+	 * Add new GIC SoCs to this #if; do not add a new #elif.
+	 */
+#if defined(CONFIG_SOC_ECONET_EN7528) || defined(CONFIG_SOC_ECONET_EN751627)
+	mips_cm_probe();
+	mips_cpc_probe();
+
+	if (!register_cps_smp_ops())
+		return;
+#endif
 	register_up_smp_ops();
 }
 
--- a/arch/mips/boot/compressed/uart-16550.c
+++ b/arch/mips/boot/compressed/uart-16550.c
@@ -21,7 +21,11 @@
 #endif
 
 #ifdef CONFIG_ECONET
+#ifdef CONFIG_CPU_LITTLE_ENDIAN
+#define EN75_UART_BASE	0x1fbf0000
+#else
 #define EN75_UART_BASE	0x1fbf0003
+#endif
 #define PORT(offset)	(CKSEG1ADDR(EN75_UART_BASE) + (4 * (offset)))
 #endif
